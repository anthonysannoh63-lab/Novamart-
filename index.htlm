
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NOVAMART - Everything You Need</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f5f6fa;color:#17233b}
header{background:#101c35;color:white;padding:22px;text-align:center}
header h1{color:#e2b84b;margin:0}
nav{background:#172744;padding:14px;text-align:center}
nav a{color:white;text-decoration:none;margin:10px;font-size:14px}
.hero{padding:45px 20px;text-align:center;background:#e9edf5}
.hero h2{font-size:30px}
.hero button,.buy{background:#d4a72c;color:#101c35;border:0;padding:13px 22px;border-radius:6px;font-weight:bold}
.search{padding:20px;text-align:center}
.search input{padding:13px;width:85%;max-width:400px;border:1px solid #ccc;border-radius:6px}
.products{padding:20px;display:grid;grid-template-columns:repeat(2,1fr);gap:15px}
.product{background:white;padding:15px;border-radius:10px;text-align:center;box-shadow:0 2px 8px #ddd}
.product .emoji{font-size:48px}
.product h3{margin:10px 0}
.product p{color:#777;font-size:13px}
footer{background:#101c35;color:white;text-align:center;padding:25px;margin-top:25px}
</style>
</head>
<body>
<header>
<h1>NOVAMART</h1>
<p>Everything You Need, All in One Place</p>
</header>
<nav>
<a href="#home">Home</a>
<a href="#shop">Shop</a>
<a href="#contact">Contact</a>
</nav>
<section class="hero" id="home">
<h2>Welcome to NOVAMART</h2>
<p>Discover amazing products at affordable prices.</p>
<button onclick="document.getElementById('shop').scrollIntoView()">Start Shopping</button>
</section>
<div class="search">
<input type="text" id="search" placeholder="Search products..." oninput="filterProducts()">
</div>
<section class="products" id="shop">
<div class="product"><div class="emoji">👕</div><h3>Clothing</h3><p>Fashion for everyone</p><button class="buy" onclick="order('Clothing')">Order</button></div>
<div class="product"><div class="emoji">👟</div><h3>Shoes</h3><p>Footwear collection</p><button class="buy" onclick="order('Shoes')">Order</button></div>
<div class="product"><div class="emoji">📱</div><h3>Electronics</h3><p>Useful technology</p><button class="buy" onclick="order('Electronics')">Order</button></div>
<div class="product"><div class="emoji">👜</div><h3>Bags</h3><p>Style and convenience</p><button class="buy" onclick="order('Bags')">Order</button></div>
<div class="product"><div class="emoji">⌚</div><h3>Accessories</h3><p>Complete your style</p><button class="buy" onclick="order('Accessories')">Order</button></div>
<div class="product"><div class="emoji">🏠</div><h3>Home Items</h3><p>Things for your home</p><button class="buy" onclick="order('Home Items')">Order</button></div>
</section>
<footer id="contact">
<h3>NOVAMART</h3>
<p>Shop smart. Shop easy.</p>
<p>Contact us for orders and enquiries.</p>
</footer>
<script>
function order(product){
alert("Thank you for choosing NOVAMART! Contact our team to place your order for "+product+".");
}
function filterProducts(){
let q=document.getElementById('search').value.toLowerCase();
document.querySelectorAll('.product').forEach(p=>{
p.style.display=p.innerText.toLowerCase().includes(q)?"block":"none";
});
}
</script>
</body>

<section id="account" style="background:white;padding:25px;margin:20px;border-radius:12px;text-align:center">
<h2>Customer Account</h2>
<p>Create an account or sign in to NOVAMART.</p>

<h3>Create Account</h3>
<input id="regName" type="text" placeholder="Your full name" style="padding:12px;width:90%;margin:6px">
<input id="regEmail" type="email" placeholder="Your email address" style="padding:12px;width:90%;margin:6px">
<button class="buy" onclick="alert('Account registration will be connected to our secure account system soon.')">Register</button>

<hr style="margin:25px">

<h3>Customer Login</h3>
<input type="email" placeholder="Your email address" style="padding:12px;width:90%;margin:6px">
<button class="buy" onclick="alert('Secure login will be activated after account setup.')">Login</button>
</section>

</html>
